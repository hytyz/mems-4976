@model List<VotingGuideGroup>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Printable Voting Guide";
}

<div class="print-guide">
    <div class="d-flex justify-content-between mb-4 no-print">
        <a class="btn btn-outline-secondary" asp-action="Index">← Back to my guide</a>
        <button class="btn btn-primary" onclick="window.print()">🖨️ Print this guide</button>
    </div>
    <h1 class="h2">Personal Voting Guide</h1>
    <p class="text-muted mb-4">Printed on @DateTime.Now.ToString("MMMM d, yyyy")</p>

    @if (!Model.Any())
    {
        <p>Your voting guide is empty.</p>
    }

    @foreach (var group in Model)
    {
        <section class="mb-4">
            <h2 class="h4 mb-0">@group.Municipality.Name</h2>
            <p class="text-muted">Election date: @group.Municipality.ElectionDate.ToString("MMMM d, yyyy")</p>

            @foreach (var position in group.Candidates.GroupBy(c => c.Position!).OrderBy(g => g.Key.Name))
            {
                <h3 class="h5 mt-4 border-bottom pb-2">
                    @position.Key.Name
                    <span class="text-muted fs-6 fw-normal">— vote for up to @position.Key.SeatsAvailable</span>
                </h3>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var candidate in position)
                    {
                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body d-flex gap-3">
                                    @if (!string.IsNullOrWhiteSpace(candidate.PhotoFileName))
                                    {
                                        <img src="~/uploads/candidates/@candidate.PhotoFileName" class="avatar" alt="" />
                                    }
                                    <div>
                                        <h4 class="h6 card-title mb-1">☐ @candidate.Name</h4>
                                        @if (!string.IsNullOrWhiteSpace(candidate.Profile))
                                        {
                                            <p class="card-text small mb-0">@candidate.Profile</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

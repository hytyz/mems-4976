@model IEnumerable<Municipality>
@{
    ViewData["Title"] = "Home";
    var municipalities = Model.ToList();
    int positionCount = municipalities.Sum(m => m.Positions.Count);
    int candidateCount = municipalities.Sum(m => m.Positions.Sum(p => p.Candidates.Count));
    bool signedIn = User.Identity?.IsAuthenticated == true;
}

<section class="hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold mb-3">Know your candidates before you vote.</h1>
            <p class="lead mb-4">
                Browse every municipality, read candidate profiles and endorsements, compare them side by side,
                and build a personal voting guide to take to the polls.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-accent btn-lg" asp-controller="Candidates" asp-action="Index">Browse candidates</a>
                @if (!signedIn)
                {
                    <a class="btn btn-outline-light btn-lg" asp-controller="VotingGuide" asp-action="Index">My voting guide</a>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-stats justify-content-lg-end">
                <div class="hero-stat"><strong>@municipalities.Count</strong><span>Municipalities</span></div>
                <div class="hero-stat"><strong>@positionCount</strong><span>Positions</span></div>
                <div class="hero-stat"><strong>@candidateCount</strong><span>Candidates</span></div>
            </div>
        </div>
    </div>
</section>

<h2 class="h4 section-title mb-3">Municipalities</h2>

@if (!municipalities.Any())
{
    <div class="alert alert-info">No municipalities are available yet.</div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var municipality in municipalities)
    {
        int candidates = municipality.Positions.Sum(p => p.Candidates.Count);
        <div class="col">
            <div class="card h-100 card-lift muni-card">
                <div class="muni-banner"></div>
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrWhiteSpace(municipality.LogoFileName))
                        {
                            <img src="~/uploads/municipalities/@municipality.LogoFileName" alt="@municipality.Name logo" class="muni-logo-sm" />
                        }
                        else
                        {
                            <span class="muni-initial" aria-hidden="true">@municipality.Name[..1]</span>
                        }
                        <div>
                            <h3 class="h5 card-title mb-0">@municipality.Name</h3>
                            <span class="text-muted small">@municipality.Province</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(municipality.Description))
                    {
                        <p class="card-text">@municipality.Description</p>
                    }
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="meta-pill">📅 @municipality.ElectionDate.ToString("MMM d, yyyy")</span>
                        <span class="meta-pill">🏛️ @municipality.Positions.Count position@(municipality.Positions.Count == 1 ? "" : "s")</span>
                        <span class="meta-pill">👥 @candidates candidate@(candidates == 1 ? "" : "s")</span>
                    </div>
                    <a class="btn btn-outline-primary mt-auto stretched-link" asp-controller="Home" asp-action="Municipality" asp-route-id="@municipality.MunicipalityId">View positions &amp; candidates</a>
                </div>
            </div>
        </div>
    }
</div>

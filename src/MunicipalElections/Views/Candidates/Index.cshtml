@model IEnumerable<Candidate>
@{
    ViewData["Title"] = "Candidates";
    var search = (string?)ViewData["Search"];
    var municipalityId = ViewData["MunicipalityId"] as int?;
    var positionId = ViewData["PositionId"] as int?;
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var total = (int)(ViewData["Total"] ?? 0);
}

<h1 class="h3 mb-4">Candidate Directory</h1>

<form method="get" class="row g-2 align-items-end mb-4 no-print">
    <div class="col-12 col-md-4">
        <label class="form-label" for="search">Search by name or profile</label>
        <input type="search" id="search" name="search" value="@search" class="form-control" placeholder="Search candidates..." />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="municipalityId">Municipality</label>
        <select id="municipalityId" name="municipalityId" class="form-select" asp-items="ViewBag.Municipalities">
            <option value="">All municipalities</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="positionId">Position</label>
        <select id="positionId" name="positionId" class="form-select" asp-items="ViewBag.Positions">
            <option value="">All positions</option>
        </select>
    </div>
    <div class="col-12 col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<p class="text-muted">@total candidate@(total == 1 ? "" : "s") found</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No candidates match your search. Try different filters.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var candidate in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(candidate.PhotoFileName))
                    {
                        <img src="~/uploads/candidates/@candidate.PhotoFileName" class="candidate-photo card-img-top" alt="@candidate.Name" />
                    }
                    else
                    {
                        <div class="candidate-photo card-img-top d-flex align-items-center justify-content-center bg-secondary-subtle text-secondary">
                            <span>No photo</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@candidate.Name</h2>
                        <p class="card-text text-muted mb-1">@candidate.Position!.Municipality!.Name</p>
                        <p class="card-text">@candidate.Position!.Name</p>
                        <a class="btn btn-outline-primary mt-auto" asp-action="Details" asp-route-id="@candidate.CandidateId">View profile</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Candidate pages" class="mt-4 no-print">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-municipalityId="@municipalityId"
                           asp-route-positionId="@positionId"
                           asp-route-page="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

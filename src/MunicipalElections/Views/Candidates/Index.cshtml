@model IEnumerable<Candidate>
@{
    ViewData["Title"] = "Candidates";
    var search = (string?)ViewData["Search"];
    var municipalityId = ViewData["MunicipalityId"] as int?;
    var positionId = ViewData["PositionId"] as int?;
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var total = (int)(ViewData["Total"] ?? 0);
    bool canUseGuide = (bool)(ViewData["CanUseGuide"] ?? false);
    var guideIds = (ViewData["GuideIds"] as List<int>) ?? new List<int>();
    string here = Context.Request.Path + Context.Request.QueryString;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1 class="h2 mb-1">Candidate Directory</h1>
        <p class="text-muted mb-0">@total candidate@(total == 1 ? "" : "s") found</p>
    </div>
    <a class="btn btn-outline-primary no-print" asp-action="Compare">Compare two candidates</a>
</div>

<form method="get" class="filter-bar row g-2 align-items-end mb-4 mx-0 no-print">
    <div class="col-12 col-md-4">
        <label class="form-label small text-muted" for="search">Search by name or profile</label>
        <input type="search" id="search" name="search" value="@search" class="form-control" placeholder="Search candidates..." />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small text-muted" for="municipalityId">Municipality</label>
        <select id="municipalityId" name="municipalityId" class="form-select" asp-items="ViewBag.Municipalities" onchange="this.form.positionId.value=''; this.form.submit()">
            <option value="">All municipalities</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small text-muted" for="positionId">Position</label>
        <select id="positionId" name="positionId" class="form-select" asp-items="ViewBag.Positions">
            <option value="">@(municipalityId.HasValue ? "All positions" : "Choose a municipality first")</option>
        </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
        @if (!string.IsNullOrEmpty(search) || municipalityId.HasValue || positionId.HasValue)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" title="Clear filters">✕</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No candidates match your search. Try different filters.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var candidate in Model)
        {
            bool inGuide = guideIds.Contains(candidate.CandidateId);
            <div class="col">
                <div class="card h-100 card-lift position-relative">
                    @if (!string.IsNullOrWhiteSpace(candidate.PhotoFileName))
                    {
                        <img src="~/uploads/candidates/@candidate.PhotoFileName" class="candidate-photo" alt="@candidate.Name" />
                    }
                    else
                    {
                        <div class="candidate-placeholder" aria-hidden="true">@string.Concat(candidate.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]))</div>
                    }
                    @if (inGuide)
                    {
                        <span class="in-guide-ribbon">★ In my guide</span>
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title mb-2">@candidate.Name</h2>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge rounded-pill position-badge">@candidate.Position!.Name</span>
                            <span class="meta-pill">📍 @candidate.Position!.Municipality!.Name</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(candidate.Profile))
                        {
                            <p class="card-text small text-muted">@(candidate.Profile.Length > 120 ? candidate.Profile[..120] + "…" : candidate.Profile)</p>
                        }
                        <div class="d-flex gap-2 mt-auto">
                            <a class="btn btn-outline-primary flex-grow-1" asp-action="Details" asp-route-id="@candidate.CandidateId">View profile</a>
                            @if (canUseGuide)
                            {
                                <form asp-controller="VotingGuide" asp-action="@(inGuide ? "Remove" : "Add")" method="post" class="no-print">
                                    <input type="hidden" name="candidateId" value="@candidate.CandidateId" />
                                    <input type="hidden" name="returnUrl" value="@here" />
                                    @if (inGuide)
                                    {
                                        <button type="submit" class="btn btn-outline-danger" title="Remove from my voting guide" aria-label="Remove @candidate.Name from my voting guide">−</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary" title="Add to my voting guide" aria-label="Add @candidate.Name to my voting guide">+</button>
                                    }
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Candidate pages" class="mt-4 no-print">
            <ul class="pagination justify-content-center">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-municipalityId="@municipalityId" asp-route-positionId="@positionId" asp-route-page="@(page - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-municipalityId="@municipalityId"
                           asp-route-positionId="@positionId"
                           asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-municipalityId="@municipalityId" asp-route-positionId="@positionId" asp-route-page="@(page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}

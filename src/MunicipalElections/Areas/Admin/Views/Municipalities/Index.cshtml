@model IEnumerable<Municipality>
@{
    ViewData["Title"] = "Municipalities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Municipalities</h1>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Province</th>
                <th>Election Date</th>
                <th>Logo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Province</td>
                    <td>@item.ElectionDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.LogoFileName))
                        {
                            <img src="~/uploads/municipalities/@item.LogoFileName" alt="@item.Name logo" style="max-height:40px" />
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.MunicipalityId">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MunicipalityId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.MunicipalityId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

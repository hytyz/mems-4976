@model IEnumerable<Municipality>
@{
    bool isSuperAdmin = User.IsInRole(Roles.SuperAdmin);
    ViewData["Title"] = isSuperAdmin ? "Municipalities" : "My municipality";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    @if (isSuperAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">+ New municipality</a>
    }
</div>

<div class="table-responsive table-card">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Logo</th>
                <th>Name</th>
                <th>Province</th>
                <th>Election date</th>
                <th>Admin group</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.LogoFileName))
                        {
                            <img src="~/uploads/municipalities/@item.LogoFileName" alt="@item.Name logo" class="muni-logo-sm" />
                        }
                        else
                        {
                            <span class="muni-initial" aria-hidden="true">@item.Name[..1]</span>
                        }
                    </td>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Province</td>
                    <td>@item.ElectionDate.ToString("yyyy-MM-dd")</td>
                    <td><span class="badge text-bg-secondary">@item.AdminRoleName</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.MunicipalityId">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MunicipalityId">Edit</a>
                        @if (isSuperAdmin)
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.MunicipalityId">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

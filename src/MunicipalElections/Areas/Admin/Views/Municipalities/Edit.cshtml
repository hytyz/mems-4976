@model Municipality
@{
    ViewData["Title"] = "Edit Municipality";
}

<h1 class="h3">Edit Municipality</h1>
<hr />

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="MunicipalityId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Province" class="form-label"></label>
            <input asp-for="Province" class="form-control" />
            <span asp-validation-for="Province" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ElectionDate" class="form-label"></label>
            <input asp-for="ElectionDate" class="form-control" type="date" />
            <span asp-validation-for="ElectionDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Logo image</label>
            @if (!string.IsNullOrWhiteSpace(Model.LogoFileName))
            {
                <div class="mb-2">
                    <img src="~/uploads/municipalities/@Model.LogoFileName" alt="Current logo" style="max-height:60px" />
                </div>
            }
            <input type="file" name="logoFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="removeLogo" value="true" id="removeLogo" />
                <label class="form-check-label" for="removeLogo">Remove current logo</label>
            </div>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

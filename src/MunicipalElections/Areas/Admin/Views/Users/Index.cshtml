@model List<AdminUserListItem>
@{
    ViewData["Title"] = "Administrators";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1 class="h2 mb-1">Administrators</h1>
        <p class="text-muted mb-0">Accounts can only be created here. There is no public registration.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New administrator</a>
</div>

<div class="table-responsive table-card">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Username</th>
                <th>Admin group</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">
                        👤 @user.UserName
                        @if (user.IsCurrentUser)
                        {
                            <span class="badge text-bg-info ms-1">you</span>
                        }
                    </td>
                    <td>
                        @if (user.Groups.Any())
                        {
                            foreach (var group in user.Groups)
                            {
                                <span class="badge @(group == Roles.SuperAdmin ? "text-bg-primary" : "text-bg-secondary") me-1">@group</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No group (no access)</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="ResetPassword" asp-route-id="@user.Id">Reset password</a>
                        @if (!user.IsCurrentUser)
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model AdminUserListItem
@{
    ViewData["Title"] = "Delete Administrator";
}

<div class="page-header">
    <h1 class="h2 mb-1">Delete Administrator</h1>
    <p class="text-danger mb-0">Are you sure you want to delete this account?</p>
</div>

<div class="card form-card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Username</dt><dd class="col-sm-9">@Model.UserName</dd>
            <dt class="col-sm-3">Admin group</dt><dd class="col-sm-9">@(Model.Groups.Any() ? string.Join(", ", Model.Groups) : "—")</dd>
        </dl>
    </div>
</div>

@if (Model.IsCurrentUser)
{
    <div class="alert alert-warning">You cannot delete the account you are signed in with.</div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
}
else
{
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
}

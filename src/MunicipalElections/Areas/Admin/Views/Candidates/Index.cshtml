@model IEnumerable<Candidate>
@{
    ViewData["Title"] = "Candidates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Candidates</h1>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Municipality</th>
                <th>Position</th>
                <th>Photo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Position!.Municipality!.Name</td>
                    <td>@item.Position!.Name</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.PhotoFileName))
                        {
                            <img src="~/uploads/candidates/@item.PhotoFileName" alt="@item.Name" style="max-height:40px;max-width:60px;object-fit:cover" />
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.CandidateId">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CandidateId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.CandidateId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

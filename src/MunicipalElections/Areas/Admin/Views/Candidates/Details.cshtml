@model Candidate
@{
    ViewData["Title"] = Model.Name;
}

<h1 class="h3">@Model.Name</h1>
<hr />
<div class="d-flex gap-3 align-items-start">
    @if (!string.IsNullOrWhiteSpace(Model.PhotoFileName))
    {
        <img src="~/uploads/candidates/@Model.PhotoFileName" alt="@Model.Name" style="max-height:120px" class="rounded" />
    }
    <dl class="row mb-0 flex-grow-1">
        <dt class="col-sm-3">Municipality</dt><dd class="col-sm-9">@Model.Position!.Municipality!.Name</dd>
        <dt class="col-sm-3">Position</dt><dd class="col-sm-9">@Model.Position!.Name</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Website</dt><dd class="col-sm-9">@Model.Website</dd>
        <dt class="col-sm-3">Biography</dt><dd class="col-sm-9">@Model.Profile</dd>
    </dl>
</div>

@if (Model.Endorsements.Any())
{
    <h2 class="h5 mt-4">Endorsements</h2>
    <ul class="list-group mb-3">
        @foreach (var endorsement in Model.Endorsements)
        {
            <li class="list-group-item">
                <strong>@endorsement.EndorserName</strong>
                @if (!string.IsNullOrWhiteSpace(endorsement.Organization))
                {
                    <span class="text-muted">(@endorsement.Organization)</span>
                }
                @if (!string.IsNullOrWhiteSpace(endorsement.Text))
                {
                    <div class="small text-muted">@endorsement.Text</div>
                }
            </li>
        }
    </ul>
}

<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.CandidateId">Edit</a>
<a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>

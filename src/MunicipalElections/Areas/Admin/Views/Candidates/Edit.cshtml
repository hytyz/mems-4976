@model Candidate
@{
    ViewData["Title"] = "Edit Candidate";
}

<h1 class="h3">Edit Candidate</h1>
<hr />

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="CandidateId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PositionId" class="form-label"></label>
            <select asp-for="PositionId" class="form-select" asp-items="ViewBag.PositionId"></select>
            <span asp-validation-for="PositionId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Website" class="form-label"></label>
            <input asp-for="Website" class="form-control" />
            <span asp-validation-for="Website" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="VideoUrl" class="form-label">Video URL</label>
            <input asp-for="VideoUrl" class="form-control" />
            <span asp-validation-for="VideoUrl" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PhotoFileName" class="form-label">Photograph</label>
            @if (!string.IsNullOrWhiteSpace(Model.PhotoFileName))
            {
                <div class="mb-2">
                    <img src="~/uploads/candidates/@Model.PhotoFileName" alt="Current photo" style="max-height:60px" />
                </div>
            }
            <input type="file" name="photoFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="removePhoto" value="true" id="removePhoto" />
                <label class="form-check-label" for="removePhoto">Remove current photo</label>
            </div>
        </div>
        <div class="col-md-3">
            <label asp-for="SocialX" class="form-label">X (Twitter)</label>
            <input asp-for="SocialX" class="form-control" />
            <span asp-validation-for="SocialX" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SocialFacebook" class="form-label">Facebook</label>
            <input asp-for="SocialFacebook" class="form-control" />
            <span asp-validation-for="SocialFacebook" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SocialInstagram" class="form-label">Instagram</label>
            <input asp-for="SocialInstagram" class="form-control" />
            <span asp-validation-for="SocialInstagram" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SocialLinkedIn" class="form-label">LinkedIn</label>
            <input asp-for="SocialLinkedIn" class="form-control" />
            <span asp-validation-for="SocialLinkedIn" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Profile" class="form-label">Biography / Profile</label>
            <textarea asp-for="Profile" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Profile" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

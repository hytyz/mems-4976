@model List<Municipality>
@{
    ViewData["Title"] = "Admin Dashboard";
    var isSuperAdmin = (bool)(ViewData["IsSuperAdmin"] ?? false);
}

<div class="page-header">
    <h1 class="h2 mb-1">Admin Dashboard</h1>
    <p class="text-muted mb-0">
        @if (isSuperAdmin)
        {
            <span>You are a super administrator and can manage every municipality and all administrator accounts.</span>
        }
        else
        {
            <span>You administer <strong>@string.Join(", ", Model.Select(m => m.Name))</strong>. Only its positions and candidates are shown.</span>
        }
    </p>
</div>

<div class="row g-3 mb-5">
    <div class="col-sm-6 col-lg">
        <a class="card stat-card stat-blue text-decoration-none h-100" asp-controller="Municipalities" asp-action="Index">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-uppercase opacity-75">@(Model.Count == 1 ? "Municipality" : "Municipalities")</div>
                    <div class="display-6 fw-bold">@ViewData["MunicipalityCount"]</div>
                </div>
                <span class="stat-icon" aria-hidden="true">🏙️</span>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg">
        <a class="card stat-card stat-green text-decoration-none h-100" asp-controller="Positions" asp-action="Index">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-uppercase opacity-75">Positions</div>
                    <div class="display-6 fw-bold">@ViewData["PositionCount"]</div>
                </div>
                <span class="stat-icon" aria-hidden="true">🏛️</span>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg">
        <a class="card stat-card stat-amber text-decoration-none h-100" asp-controller="Candidates" asp-action="Index">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-uppercase opacity-75">Candidates</div>
                    <div class="display-6 fw-bold">@ViewData["CandidateCount"]</div>
                </div>
                <span class="stat-icon" aria-hidden="true">👥</span>
            </div>
        </a>
    </div>
    @if (isSuperAdmin)
    {
        <div class="col-sm-6 col-lg">
            <a class="card stat-card stat-purple text-decoration-none h-100" asp-controller="Users" asp-action="Index">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-uppercase opacity-75">Administrators</div>
                        <div class="display-6 fw-bold">@ViewData["UserCount"]</div>
                    </div>
                    <span class="stat-icon" aria-hidden="true">🔑</span>
                </div>
            </a>
        </div>
    }
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 section-title mb-0">@(isSuperAdmin ? "Municipalities" : "Your municipality")</h2>
    <div class="d-flex flex-wrap gap-2">
        @if (isSuperAdmin)
        {
            <a class="btn btn-primary" asp-controller="Municipalities" asp-action="Create">+ New municipality</a>
            <a class="btn btn-outline-primary" asp-controller="Users" asp-action="Create">+ New administrator</a>
        }
        <a class="btn btn-outline-primary" asp-controller="Positions" asp-action="Create">+ New position</a>
        <a class="btn btn-outline-primary" asp-controller="Candidates" asp-action="Create">+ New candidate</a>
    </div>
</div>

<div class="table-responsive table-card">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Municipality</th>
                <th>Election date</th>
                <th>Admin group</th>
                <th class="text-end">Positions</th>
                <th class="text-end">Candidates</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var municipality in Model)
            {
                <tr>
                    <td class="fw-semibold">@municipality.Name</td>
                    <td>@municipality.ElectionDate.ToString("MMM d, yyyy")</td>
                    <td><span class="badge text-bg-secondary">@municipality.AdminRoleName</span></td>
                    <td class="text-end">@municipality.Positions.Count</td>
                    <td class="text-end">@municipality.Positions.Sum(p => p.Candidates.Count)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Municipalities" asp-action="Details" asp-route-id="@municipality.MunicipalityId">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

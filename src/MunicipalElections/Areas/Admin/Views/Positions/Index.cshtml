@model IEnumerable<Position>
@{
    ViewData["Title"] = "Positions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Positions</h1>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Municipality</th>
                <th>Seats Available</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Municipality!.Name</td>
                    <td>@item.SeatsAvailable</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.PositionId">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.PositionId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.PositionId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

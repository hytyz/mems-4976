@model Position
@{
    ViewData["Title"] = Model.Name;
}

<h1 class="h3">@Model.Name</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Municipality</dt><dd class="col-sm-9">@Model.Municipality!.Name</dd>
    <dt class="col-sm-3">Seats Available</dt><dd class="col-sm-9">@Model.SeatsAvailable</dd>
</dl>

<h2 class="h5">Candidates</h2>
@if (Model.Candidates.Any())
{
    <ul class="list-group mb-3">
        @foreach (var candidate in Model.Candidates)
        {
            <li class="list-group-item">@candidate.Name</li>
        }
    </ul>
}
else
{
    <p class="text-muted">No candidates yet.</p>
}

<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.PositionId">Edit</a>
<a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>

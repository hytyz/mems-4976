@model Position
@{
    ViewData["Title"] = "Delete Position";
}

<h1 class="h3">Delete Position</h1>
<h2 class="h5 text-danger">Are you sure you want to delete this?</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Municipality</dt><dd class="col-sm-9">@Model.Municipality!.Name</dd>
    <dt class="col-sm-3">Seats Available</dt><dd class="col-sm-9">@Model.SeatsAvailable</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PositionId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
</form>

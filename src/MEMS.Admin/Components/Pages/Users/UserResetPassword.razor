@page "/users/{Id}/reset-password"
@inject IAdminUserService AdminUsers
@inject NavigationManager Navigation
@inject FlashService Flash

<PageTitle>Reset password · MEMS Admin</PageTitle>

@if (notFound)
{
    <NotFoundMessage Title="Administrator not found" BackHref="users" BackText="Back to administrators" />
}
else if (user is not null)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="users">Administrators</a></li>
            <li class="breadcrumb-item active" aria-current="page">@user.UserName</li>
        </ol>
    </nav>
    <h1 class="h3 mb-4">Reset password for @user.UserName</h1>

    <EditForm Model="input" OnValidSubmit="SaveAsync" FormName="reset-password" class="card form-card shadow-sm" style="max-width: 32rem">
        <div class="card-body p-4">
            <DataAnnotationsValidator />
            <ServerValidation @ref="serverValidation" />
            <ValidationSummary class="alert alert-danger py-2 small" />
            <div class="mb-3">
                <label class="form-label" for="password">New password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="input.Password" autocomplete="new-password" />
                <ValidationMessage For="() => input.Password" class="text-danger small" />
            </div>
            <div class="mb-2">
                <label class="form-label" for="confirm">Confirm password</label>
                <InputText id="confirm" type="password" class="form-control" @bind-Value="input.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => input.ConfirmPassword" class="text-danger small" />
            </div>
            <div class="form-text">@PasswordRules.Summary The account will be signed out of any open sessions.</div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2 bg-transparent">
            <a class="btn btn-outline-secondary" href="users">Cancel</a>
            <button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "Saving…" : "Reset password")</button>
        </div>
    </EditForm>
}

@code {
    private ResetPasswordInput input = new();
    private AdminUserDto? user;
    private ServerValidation? serverValidation;
    private bool notFound;
    private bool saving;

    [Parameter] public string Id { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var result = await AdminUsers.GetAsync(Id);
        user = result.Value;
        notFound = user is null;
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var result = await AdminUsers.ResetPasswordAsync(Id, input);
            if (result.IsSuccess)
            {
                Flash.Success($"The password for '{user!.UserName}' was changed.");
                Navigation.NavigateTo("users");
                return;
            }

            serverValidation?.Display(result.Status is ResultStatus.Invalid
                ? result.Errors
                : new Dictionary<string, string[]> { [string.Empty] = [result.Message ?? "The password could not be changed."] });
        }
        finally
        {
            saving = false;
        }
    }
}

<div class="d-flex flex-wrap align-items-start gap-3">
    <div class="image-preview">
        @if ((previewUrl ?? (Remove ? null : CurrentUrl)) is { } src)
        {
            <img src="@src" alt="@Label preview" />
        }
        else
        {
            <span class="text-secondary small">No image</span>
        }
    </div>
    <div class="flex-grow-1" style="min-width: 14rem">
        <label class="form-label" for="@Id">@Label</label>
        <InputFile id="@Id" class="form-control" accept="@ImageRules.Accept" OnChange="OnFileSelectedAsync" disabled="@loading" />
        <div class="form-text">JPG, PNG, GIF or WEBP, up to @ImageRules.MaxSizeText.</div>
        @if (error is not null)
        {
            <div class="text-danger small mt-1" role="alert">@error</div>
        }
        @if (CurrentUrl is not null && Content is null)
        {
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="@($"{Id}-remove")" @bind="Remove" />
                <label class="form-check-label" for="@($"{Id}-remove")">Remove the current image</label>
            </div>
        }
        @if (Content is not null)
        {
            <button type="button" class="btn btn-link btn-sm px-0" @onclick="ClearSelection">Undo selection</button>
        }
    </div>
</div>

@code {
    private string? previewUrl;
    private string? error;
    private bool loading;

    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Image";

    [Parameter] public string? CurrentUrl { get; set; }

    public byte[]? Content { get; private set; }

    public bool Remove { get; set; }

    public bool HasError => error is not null;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        ClearSelection();
        var file = e.File;

        if (file.Size > ImageRules.MaxBytes)
        {
            error = $"The image must be {ImageRules.MaxSizeText} or smaller.";
            return;
        }

        string extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!ImageRules.Accept.Split(',').Contains(extension))
        {
            error = "Only JPG, PNG, GIF and WEBP images are allowed.";
            return;
        }

        loading = true;
        try
        {
            await using var stream = file.OpenReadStream(ImageRules.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            byte[] bytes = buffer.ToArray();

            string? contentType = ImageInspector.DetectContentType(bytes);
            if (contentType is null)
            {
                error = "The file is not a valid JPG, PNG, GIF or WEBP image.";
                return;
            }

            Content = bytes;
            previewUrl = $"data:{contentType};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (IOException)
        {
            error = "The file could not be read. Please choose it again.";
        }
        finally
        {
            loading = false;
        }
    }

    private void ClearSelection()
    {
        Content = null;
        previewUrl = null;
        error = null;
        Remove = false;
    }
}

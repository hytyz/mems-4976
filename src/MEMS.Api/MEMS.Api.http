###
# @name burnabyLogin
POST {{api}}/api/auth/login
Content-Type: application/json

{ "userName": "burnabyadmin", "password": "P@$$w0rd" }

###
@burnabyToken = {{burnabyLogin.response.body.accessToken}}

# @name superLogin
POST {{api}}/api/auth/login
Content-Type: application/json

{ "userName": "super", "password": "P@$$w0rd" }

###
@superToken = {{superLogin.response.body.accessToken}}

###
POST {{api}}/api/auth/login
Content-Type: application/json

{ "userName": "burnabyadmin", "password": "wrong" }

###
POST {{api}}/api/burnaby/positions
Authorization: Bearer {{burnabyToken}}
Content-Type: application/json

{ "name": "Park Board Commissioner", "seatsAvailable": 3 }

###
POST {{api}}/api/surrey/positions
Authorization: Bearer {{burnabyToken}}
Content-Type: application/json

{ "name": "Not allowed", "seatsAvailable": 1 }

###
POST {{api}}/api/burnaby/candidates
Authorization: Bearer {{burnabyToken}}
Content-Type: application/json

{ "name": "A", "email": "not-an-email", "website": "javascript:alert(1)", "positionId": 1 }

###
DELETE {{api}}/api/burnaby/candidates/1

###
DELETE {{api}}/api/municipalities/2
Authorization: Bearer {{burnabyToken}}

###
POST {{api}}/api/municipalities
Authorization: Bearer {{superToken}}
Content-Type: application/json

{
  "name": "Coquitlam",
  "slug": "coquitlam",
  "province": "British Columbia",
  "electionDate": "2026-10-17",
  "tagline": "Where trails meet the city.",
  "themeColor": "#9a3412"
}

###
POST {{api}}/api/municipalities
Authorization: Bearer {{superToken}}
Content-Type: application/json

{ "name": "Another Burnaby", "slug": "burnaby", "province": "British Columbia", "electionDate": "2026-10-17", "themeColor": "#112233" }

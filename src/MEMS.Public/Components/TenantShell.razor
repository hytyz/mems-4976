@* Frame for every tenant page: resolves the slug in the URL to a municipality through the API,
   applies that municipality's branding (colour, logo, tagline) and shows its navigation.
   An unknown slug shows a friendly "not found"; nothing from another municipality is ever shown. *@
@implements IDisposable
@inject TenantCache Tenants
@inject VotingGuide Guide
@inject ApiUrls Urls

@if (error is not null)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
else if (loading)
{
    <div class="text-center text-secondary py-5"><div class="spinner-border" role="status"></div></div>
}
else if (municipality is null)
{
    <PageTitle>Municipality not found · Municipal Elections</PageTitle>
    <div class="text-center py-5">
        <div class="display-6 mb-2" aria-hidden="true">🏛️</div>
        <h1 class="h4">Municipality not found</h1>
        <p class="text-secondary">There is no municipality at <code>/@Slug</code>.</p>
        <a class="btn btn-primary" href="">See all municipalities</a>
    </div>
}
else
{
    <div class="tenant-scope" style="@ThemeStyle">
        <header class="tenant-header no-print">
            <div class="d-flex flex-wrap align-items-center gap-3">
                @if (Urls.Image(municipality.Slug, municipality.LogoImageId) is { } logo)
                {
                    <img src="@logo" alt="@($"{municipality.Name} logo")" class="tenant-logo" />
                }
                else
                {
                    <span class="tenant-logo tenant-initial" aria-hidden="true">@municipality.Name[0]</span>
                }
                <div class="flex-grow-1">
                    <a class="tenant-name" href="@municipality.Slug">@municipality.Name</a>
                    <div class="tenant-tagline">@(municipality.Tagline ?? $"{municipality.Province} municipal election")</div>
                </div>
                <div class="tenant-election text-end">
                    <div class="small text-uppercase opacity-75">Election day</div>
                    <div class="fw-bold">@municipality.ElectionDate.ToString("MMMM d, yyyy")</div>
                </div>
            </div>
            <ul class="nav tenant-nav mt-3">
                <li class="nav-item"><NavLink class="nav-link" href="@municipality.Slug" Match="NavLinkMatch.All">Overview</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="@($"{municipality.Slug}/candidates")">Candidates</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="@($"{municipality.Slug}/compare")">Compare</NavLink></li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="@($"{municipality.Slug}/guide")">
                        My voting guide
                        @if (guideCount > 0)
                        {
                            <span class="badge rounded-pill guide-count ms-1">@guideCount</span>
                        }
                    </NavLink>
                </li>
            </ul>
        </header>

        <CascadingValue Value="municipality" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    private MunicipalityDto? municipality;
    private string? loadedSlug;
    private bool loading = true;
    private string? error;
    private int guideCount;

    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ThemeStyle => $"--tenant-color:{municipality!.ThemeColor};--tenant-contrast:{ContrastColor(municipality.ThemeColor)}";

    protected override void OnInitialized() => Guide.Changed += OnGuideChanged;

    protected override async Task OnParametersSetAsync()
    {
        string slug = Slug.ToLowerInvariant();
        if (slug == loadedSlug)
        {
            return;
        }

        loadedSlug = slug;
        loading = true;
        error = null;
        try
        {
            municipality = await Tenants.GetAsync(slug);
            guideCount = municipality is null ? 0 : (await Guide.GetAsync(slug)).Count;
        }
        catch (ApiUnavailableException ex)
        {
            error = ex.Message;
            loadedSlug = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async void OnGuideChanged(string slug)
    {
        if (string.Equals(slug, loadedSlug, StringComparison.OrdinalIgnoreCase))
        {
            guideCount = (await Guide.GetAsync(slug)).Count;
            StateHasChanged();
        }
    }

    /// <summary>White or near-black text, whichever reads better on the tenant's colour.</summary>
    private static string ContrastColor(string hex)
    {
        if (hex.Length != 7)
        {
            return "#ffffff";
        }

        int r = Convert.ToInt32(hex[1..3], 16), g = Convert.ToInt32(hex[3..5], 16), b = Convert.ToInt32(hex[5..7], 16);
        double luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luminance > 0.62 ? "#111827" : "#ffffff";
    }

    public void Dispose() => Guide.Changed -= OnGuideChanged;
}

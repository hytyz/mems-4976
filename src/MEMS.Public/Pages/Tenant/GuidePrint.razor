@page "/{Tenant}/guide/print"
@inherits TenantPage
@inject TenantCache Tenants
@inject IJSRuntime JS

<TenantShell Slug="@Tenant">
    <PageTitle>Printable voting guide · Municipal Elections</PageTitle>

    <div class="d-flex flex-wrap gap-2 mb-3 no-print">
        <a class="btn btn-outline-secondary" href="@($"{Slug}/guide")">← Back to my guide</a>
        <button type="button" class="btn btn-primary" @onclick="PrintAsync" disabled="@(chosen.Count == 0)">🖨️ Print or save as PDF</button>
    </div>

    @if (LoadError is not null)
    {
        <div class="alert alert-warning">@LoadError</div>
    }
    else if (municipality is null || groups is null)
    {
        <div class="text-center text-secondary py-5"><div class="spinner-border" role="status"></div></div>
    }
    else
    {
        <article class="print-guide card">
            <div class="card-body p-4">
                <header class="border-bottom pb-3 mb-3">
                    <h1 class="h3 mb-1">My voting guide</h1>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Municipality</dt>
                        <dd class="col-sm-9">@municipality.Name, @municipality.Province</dd>
                        <dt class="col-sm-3">Election date</dt>
                        <dd class="col-sm-9">@municipality.ElectionDate.ToString("dddd, MMMM d, yyyy")</dd>
                        <dt class="col-sm-3">Printed</dt>
                        <dd class="col-sm-9">@printedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</dd>
                    </dl>
                </header>

                @if (chosen.Count == 0)
                {
                    <p class="text-secondary mb-0">Your guide is empty. Add candidates from the candidate directory first.</p>
                }
                else
                {
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th style="width: 40%">Position</th><th>Candidate</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var group in chosen)
                            {
                                @foreach (var c in group.Candidates)
                                {
                                    <tr>
                                        <td>@group.Position.Name <span class="text-secondary small">(@group.Position.SeatsAvailable seat@(group.Position.SeatsAvailable == 1 ? "" : "s"))</span></td>
                                        <td class="fw-semibold">@c.Name</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
                <p class="small text-secondary mt-4 mb-0">
                    This guide was created in your browser and was not saved by @municipality.Name or anyone else.
                </p>
            </div>
        </article>
    }
</TenantShell>

@code {
    private MunicipalityDto? municipality;
    private List<GuideGroup>? groups;
    private DateTime printedAt = DateTime.Now;

    private List<GuideGroup> chosen => groups?.Where(g => g.Candidates.Count > 0).ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        printedAt = DateTime.Now;
        await LoadSafelyAsync(async () =>
        {
            municipality = await Tenants.GetAsync(Slug);
            groups = municipality is null ? [] : await GuideLoader.LoadAsync(Api, Guide, Slug);
        });
    }

    private async Task PrintAsync()
    {
        printedAt = DateTime.Now;
        StateHasChanged();
        await JS.InvokeVoidAsync("print");
    }
}
